# macOS. Finder writes .DS_Store into every directory it displays, and AppleDouble
# ._ files appear whenever the tree crosses a non-Apple filesystem - a zip, a USB
# stick, OneDrive. web/.gitignore already lists .DS_Store; this is the root, where
# data/, models/, reports/, scripts/ and src/ live.
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
